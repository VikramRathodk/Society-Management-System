{
  "info": {
    "name": "Society Management API",
    "description": "Run '1. Auth > Login as Admin' first: it saves the JWT into {{token}}, which every other request sends as a Bearer token. Create requests save the new id into the matching variable (societyId, wingId, flatId, userId, complexId).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "residentToken",
      "value": ""
    },
    {
      "key": "complexId",
      "value": ""
    },
    {
      "key": "societyId",
      "value": "790b485f-208b-42fc-9527-2698c22ed8cf"
    },
    {
      "key": "wingId",
      "value": "4e3b398e-e7a1-4588-a8ca-e9276d1b0c71"
    },
    {
      "key": "flatId",
      "value": "8912f59c-f065-4bb2-b8d0-7648b0fec538"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const r = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', r.token);",
                  "    pm.collectionVariables.set('token', r.token);",
                  "    console.log('Logged in as', r.role, '- permissions:', r.permissions);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Resident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"8888888888\",\n  \"password\": \"res123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const r = pm.response.json();",
                  "    pm.collectionVariables.set('residentToken', r.token);",
                  "    pm.collectionVariables.set('token', r.token);",
                  "    console.log('Logged in as', r.role, '- permissions:', r.permissions);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
